Algoritmo Triángulo
	Escribir "Programa que calcula el area de un triangulo por usted (En cm):";
	Escribir "";
	Escribir "¿Cuanto mide la Base del triangulo?  ";
	Leer base;
	
	Escribir "¿Cuanto mide la Altura del triangulo?  ";
	Leer altura;
	
	area<- (base * altura) / 2;
	
	Escribir "El area del triangulo es: ", area, "Cm";
	
FinAlgoritmo
